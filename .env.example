APP_NAME=SNAPP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# PRODUZIONE: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<dominio-api>, APP_KEY generata.

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB: stesso driver in locale e in produzione (MariaDB) per parità di comportamento.
# In LOCALE (XAMPP): DB_USERNAME=root e DB_PASSWORD vuota.
# In PRODUZIONE (VPS AlmaLinux): usare un utente dedicato CON password, NON root.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snapp
DB_USERNAME=snapp
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Invio push di massa via batch sulla coda Redis. Avviare: php artisan queue:work redis
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── SNAPP integration ──────────────────────────────────────────────
# WordPress (proxy live degli articoli + bridge verifica account)
SNAPP_WP_BASE_URL=http://localhost/wordpress
SNAPP_WP_HMAC_SECRET=

# Social OAuth (login app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Firebase Cloud Messaging (push)
# Per ABILITARE l'invio reale: metti il service-account.json nel path sotto e
# imposta FIREBASE_CREDENTIALS allo stesso path. Senza, si usa il transport "log".
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
